rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'shimadutta62@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Storefront and Admin management
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Store settings & SCF options
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Customer reviews & ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Issue reports / 48hr delivery claims
    match /issue_reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Newsletter subscribers
    match /newsletter_subscribers/{subscriberId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
